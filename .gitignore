# =============================================================
#  QAStudio Recorder — .gitignore
#  These are files/folders Git should NEVER track or commit.
# =============================================================

# --- Node.js / npm ---
# node_modules/ is the ~300MB library folder.
# Regenerable any time via `npm install`, so never commit.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.pnpm-store/

# --- Build outputs ---
# These are generated by build commands — always re-buildable.
dist/
dist-electron/
out/
build/
release/
*.exe
*.dmg
*.AppImage

# --- TypeScript ---
# Incremental compilation cache, machine-specific.
*.tsbuildinfo

# --- Environment & secrets ---
# .env files often hold API keys, passwords, tokens.
# NEVER commit — leak risk.
.env
.env.local
.env.*.local
.env.production

# --- Logs ---
*.log
logs/

# --- Test outputs ---
coverage/
.nyc_output/
playwright-report/
test-results/
playwright/.cache/

# --- IDE / Editor noise ---
.vscode/
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.idea/usage.statistics.xml
*.iml

# --- OS noise ---
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*.swo
